<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dougs.oura-retry</string>

    <key>UserName</key>
    <string>dougs</string>

    <!-- Second pass for a ring that had not uploaded to Oura by 08:00.
         /sync/oura/retry no-ops if the 08:00 run already got a real night,
         so a good table is never rewritten. Pairs with com.dougs.oura-sync. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/curl</string>
        <string>-s</string>
        <string>-m</string>
        <string>120</string>
        <string>-X</string>
        <string>POST</string>
        <string>http://127.0.0.1:9847/sync/oura/retry</string>
    </array>

    <!-- Fires at 08:30 and again at 10:00 (both no-op once a real night is in). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>10</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/oura-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/oura-sync.log</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dougs.oura-sync</string>

    <key>UserName</key>
    <string>dougs</string>

    <!-- Pull the daily Bio-Log from Oura every morning at 08:00.
         Hits the always-running logserver (com.dougs.logserver) on :9847. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/curl</string>
        <string>-s</string>
        <string>-m</string>
        <string>120</string>
        <string>-X</string>
        <string>POST</string>
        <string>http://127.0.0.1:9847/sync/oura</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/oura-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/oura-sync.log</string>
</dict>
</plist>
